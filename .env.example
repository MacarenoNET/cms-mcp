CMS_API_URL=https://api.macareno.net
CMS_ADMIN_EMAIL=admin@macareno.net
CMS_ADMIN_PASSWORD=your-password
MCP_DOMAIN=mcp.macareno.net
# Secreto de acceso al endpoint /mcp (obligatorio, minimo 32 caracteres). Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
